# ==============================================================================
# VeriFace Protocol Environment Configuration
# ==============================================================================

# Search Gateway Configuration
# Sign up at https://serper.dev for 2,500 free Google Lens searches (No credit card required).
# If left blank, the pipeline automatically runs in local evaluation mode.
SERPER_API_KEY=

# Blockchain Configuration (Optional for remote testnet broadcasting)
# Default is 'local' which runs an embedded EVM with zero gas and zero setup.
# To broadcast to Base Sepolia, provide an RPC URL and testnet private key:
BASE_SEPOLIA_RPC=https://sepolia.base.org
WALLET_PRIVATE_KEY=
